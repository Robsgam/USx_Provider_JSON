#!/bin/sh
# BLOCK A COMMIT THAT BREAKS CODE THAT MUST PARSE.
#
# WHY THIS EXISTS. On 2026-09-04 a single apostrophe inside a single-quoted console.log in
# usx_lib.js closed the string early; the file never parsed, window.__usxLib never existed, and the
# driver + capture tools were DEAD FOR FIVE DAYS -- found only when the operator opened a console.
# audit_extension_syntax.ps1 was built to catch exactly that.
#
# On 2026-09-11 I did it AGAIN -- "the build's" inside a single-quoted string in deploy_probe.js --
# and the gate DID catch it, reporting `[FAIL] deploy_probe.js -- missing ) after argument list`.
# I committed and pushed anyway, because I had chained the commit behind a `grep` that matched the
# output whether it said PASS or FAIL. Reading a verdict next to a commit is not branching on it.
#
# THEN I DID IT A THIRD TIME THE SAME DAY, in PowerShell: "USx panel's DEPLOY section" inside a
# single-quoted string in emit_import_job.ps1 -> 4 parse errors. Same defect class, different
# language, and the first version of this hook did not cover it because it only watched
# automation/extension/*.js. A mechanism that guards one instance of a recurring class and not the
# others is a mechanism that will be surprised by the next one.
#
# So: JS and PowerShell are both checked, each by the gate that owns it.
# (--no-verify still works, deliberately -- a hook that cannot be overridden in an emergency gets
# uninstalled instead of respected.)
#
# Install: tools\install_git_hooks.ps1   (hooks live outside .git so they are version-controlled)

staged=$(git diff --cached --name-only --diff-filter=ACM)
rc=0

if echo "$staged" | grep -q '^automation/extension/.*\.js$'; then
    echo "[pre-commit] extension JS staged -- running audit_extension_syntax.ps1"
    powershell -NoProfile -ExecutionPolicy Bypass -File tools/audit_extension_syntax.ps1 -Quiet || rc=1
fi

if echo "$staged" | grep -q '^tools/.*\.ps1$'; then
    echo "[pre-commit] tool scripts staged -- running audit_ps51_parse.ps1"
    powershell -NoProfile -ExecutionPolicy Bypass -File tools/audit_ps51_parse.ps1 >/dev/null 2>&1 || rc=1
    if [ $rc -ne 0 ]; then
        powershell -NoProfile -ExecutionPolicy Bypass -File tools/audit_ps51_parse.ps1 2>&1 | grep -i 'FAIL'
    fi
fi

if [ $rc -ne 0 ]; then
    echo ""
    echo "[pre-commit] BLOCKED: something staged does not parse."
    echo "             A syntax error is TOTAL -- the file never executes and every global or"
    echo "             function it defines is absent, which presents as an unrelated failure"
    echo "             somewhere else entirely."
    echo "             Fix it, or commit with --no-verify if you know why you are doing that."
    exit 1
fi
exit 0
