{
  "manifest_version": 3,
  "name": "USx Tenant Testing -- Driver + Capture",
  "version": "0.4.0",
  "description": "Drives the universal-search query form and captures dex-log request XML on the Mark43 USx tenant, feeding the post_test pipeline. In-browser; no cert needed.",
  "permissions": ["downloads"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://usx-nj-njcjis.mark43.com/rms/*",
        "https://usx-fl-fcic.mark43.com/rms/*",
        "https://usx-ca-clets.mark43.com/rms/*",
        "https://usx-tx-tlets.mark43.com/rms/*",
        "https://usx-ny-nyspin-ejustice.mark43.com/rms/*",
        "https://usx-hi-hcjdc-ofml.mark43.com/rms/*",
        "https://usx-az-azdps.mark43.com/rms/*",
        "https://usx-il-leads-ofml.mark43.com/rms/*"
      ],
      "js": ["nethook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://usx-nj-njcjis.mark43.com/rms/*",
        "https://usx-fl-fcic.mark43.com/rms/*",
        "https://usx-ca-clets.mark43.com/rms/*",
        "https://usx-tx-tlets.mark43.com/rms/*",
        "https://usx-ny-nyspin-ejustice.mark43.com/rms/*",
        "https://usx-hi-hcjdc-ofml.mark43.com/rms/*",
        "https://usx-az-azdps.mark43.com/rms/*",
        "https://usx-il-leads-ofml.mark43.com/rms/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://usx-nj-njcjis.mark43.com/rms/*",
        "https://usx-fl-fcic.mark43.com/rms/*",
        "https://usx-ca-clets.mark43.com/rms/*",
        "https://usx-tx-tlets.mark43.com/rms/*",
        "https://usx-ny-nyspin-ejustice.mark43.com/rms/*",
        "https://usx-hi-hcjdc-ofml.mark43.com/rms/*",
        "https://usx-az-azdps.mark43.com/rms/*",
        "https://usx-il-leads-ofml.mark43.com/rms/*"
      ],
      "js": ["usx_lib.js", "capture.js", "driver.js", "ui.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
